<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="filecheck.OrderPanel">
        <div class="o_filecheck_order_panel">
            <div t-if="state.loading" class="text-muted">
                <i class="fa fa-spinner fa-spin me-2"/>Loading Filecheck…
            </div>
            <div t-elif="state.error" class="alert alert-warning mb-0" t-esc="state.error"/>
            <t t-elif="state.data">
                <t t-set="data" t-value="state.data"/>
                <div t-if="data.error" class="alert alert-warning" t-esc="data.error"/>
                <div t-if="data.uploadUrl and data.uploadStatus !== 'complete'" class="alert alert-info">
                    Some lines are waiting for the customer's artwork.
                    <a t-att-href="data.uploadUrl" target="_blank" rel="noopener">Open the upload page</a>
                </div>
                <div t-foreach="data.lines" t-as="line" t-key="line.id" class="border-bottom py-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <strong t-esc="line.name"/>
                        <span t-if="line.outcome" t-att-class="'badge ' + badgeClass(line.outcome)" t-esc="line.outcome.toUpperCase()"/>
                        <span t-if="line.status" class="text-muted small">Job <t t-esc="line.status"/></span>
                        <span t-if="line.awaiting" class="badge text-bg-info">Awaiting artwork</span>
                        <a t-if="line.adminUrl" t-att-href="line.adminUrl" target="_blank" rel="noopener" class="small ms-auto">
                            View on Filecheck <i class="fa fa-external-link"/>
                        </a>
                    </div>
                    <div t-if="line.error" class="text-danger small" t-esc="line.error"/>
                    <div t-if="line.filesError" class="text-danger small">
                        Saving the print files: <t t-esc="line.filesError"/>
                    </div>
                    <div t-foreach="line.files" t-as="file" t-key="file_index" class="d-flex flex-wrap align-items-center gap-2 mt-1">
                        <span t-if="file.outcome" t-att-class="'badge ' + badgeClass(file.outcome)" t-esc="file.outcome.toUpperCase()"/>
                        <span t-esc="file.name"/>
                        <a t-foreach="file.proofs" t-as="proof" t-key="proof_index" t-att-href="proof" target="_blank" rel="noopener">
                            <img t-att-src="proof" alt="Proof" class="border rounded" style="width:48px;height:48px;object-fit:cover;"/>
                        </a>
                        <a t-if="file.downloadUrl" t-att-href="file.downloadUrl" target="_blank" rel="noopener" class="btn btn-link btn-sm p-0">
                            Download from Filecheck
                        </a>
                    </div>
                    <div t-if="line.saved.length" class="mt-1 small">
                        Saved on this order:
                        <t t-foreach="line.saved" t-as="att" t-key="att_index">
                            <a t-att-href="att.url" class="me-2"><i class="fa fa-download me-1"/><t t-esc="att.name"/></a>
                        </t>
                    </div>
                    <div t-elif="line.filesState === 'pending'" class="mt-1 small text-muted">
                        The print files are saved on this order once Filecheck has finished.
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
