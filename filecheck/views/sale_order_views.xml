<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_filecheck" model="ir.ui.view">
        <field name="name">sale.order.form.filecheck</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Filecheck" name="filecheck" invisible="not filecheck_has_lines">
                    <field name="filecheck_has_lines" invisible="1"/>
                    <div class="d-flex gap-2 mb-2">
                        <button name="action_filecheck_sync" type="object" class="btn btn-secondary"
                                string="Sync with Filecheck" icon="fa-refresh"/>
                    </div>
                    <widget name="filecheck_order_panel"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
